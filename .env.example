# =====================================================================
# OptiRetail AI - Retail Store Optimization Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# =====================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Application Metadata
APP_TITLE="Retail Store Optimization API"
APP_VERSION="2.0.0"
APP_DESCRIPTION="ML-driven retail demand forecasting, inventory replenishment, and dynamic pricing optimization platform"

# Security & CORS Settings (comma-separated origins, or * for all)
CORS_ORIGINS="*"

# Storage & Model Paths (relative to project root or absolute paths)
MODEL_PATH=models/demand_model.joblib
FRONTEND_DIR=frontend

# Inventory Optimization Parameters
# SERVICE_LEVEL_Z: Z-score for service level (1.65 corresponds to 95% cycle service level)
SERVICE_LEVEL_Z=1.65

# Pricing Simulation Parameters
# PRICE_ELASTICITY_DEFAULT: Price elasticity of demand coefficient
PRICE_ELASTICITY_DEFAULT=-1.65

# Financial & KPI Multipliers
# Multiplier to estimate potential lost sales prevented by proactive safety buffer
LOST_SALES_MULTIPLIER=1.6
